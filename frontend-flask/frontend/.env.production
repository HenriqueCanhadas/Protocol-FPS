# frontend/.env.production
#
# Variáveis do Supabase (necessárias no build Vite — prefixo VITE_ obrigatório):
# Configure no painel Vercel → Settings → Environment Variables
#
#   VITE_SUPABASE_URL       → 
#   VITE_SUPABASE_ANON_KEY  → 
#
# ──────────────────────────────────────────────────────────────────────────────
# Variáveis do GitHub Actions (SERVER-SIDE ONLY — sem prefixo VITE_):
# Configure no painel Vercel → Settings → Environment Variables
# Essas variáveis SÃO LIDAS APENAS pela Vercel Function (api/trigger-coleta.js)
# e NUNCA chegam ao browser ou ao bundle JS.
#
#   GITHUB_TOKEN     → PAT com permissão actions:write
#   GITHUB_OWNER     → HenriqueCanhadas
#   GITHUB_REPO      → Protocol-FPS
#   GITHUB_WORKFLOW  → coletar.yml
#
# ──────────────────────────────────────────────────────────────────────────────
# NÃO coloque valores reais neste arquivo — ele é apenas documentação.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
