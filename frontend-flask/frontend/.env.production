# frontend/.env.production
# Em produção (Vercel), configure estas variáveis no painel do Vercel.
# O Vite as injeta em tempo de build com o prefixo VITE_.
#
# No painel Vercel → Settings → Environment Variables, adicione:
#   VITE_SUPABASE_URL        → URL do projeto Supabase
#   VITE_SUPABASE_ANON_KEY   → Chave pública do Supabase
#   VITE_GITHUB_TOKEN        → PAT com scope actions:write
#   VITE_GITHUB_OWNER        → HenriqueCanhadas
#   VITE_GITHUB_REPO         → Protocol-FPS
#   VITE_GITHUB_WORKFLOW     → coletar.yml
#
# Este arquivo é apenas documentação — não coloque valores reais aqui.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_GITHUB_TOKEN=
VITE_GITHUB_OWNER=
VITE_GITHUB_REPO=
VITE_GITHUB_WORKFLOW=coletar.yml
