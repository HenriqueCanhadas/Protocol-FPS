# PROTOCOL FPS — variáveis de ambiente
# Copie para .env e preencha os valores reais.
# NUNCA commite o .env no GitHub.

# ── Supabase ──────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_KEY=SEU_SERVICE_KEY_AQUI
SUPABASE_ANON_KEY=SEU_ANON_KEY_AQUI

# ── Email (Gmail SMTP) ────────────────────────────────────────
EMAIL_REMETENTE=
EMAIL_SENHA_APP=xxxx xxxx xxxx xxxx
EMAIL_DESTINATARIO=

# ── Telegram ──────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=SEU_BOT_TOKEN
TELEGRAM_CHAT_ID=SEU_CHAT_ID

# ── GitHub Actions (disparo manual pelo frontend) ─────────────
GITHUB_TOKEN=SEU_PAT_COM_ACTIONS_WRITE
GITHUB_OWNER=HenriqueCanhadas
GITHUB_REPO=Protocol-FPS
GITHUB_WORKFLOW=coletar.yml
# Branch alvo do workflow_dispatch (opcional; default: main).
# Em dev, aponte para a branch de trabalho (ex.: Duplicate-Main) para testar
# inputs novos do workflow ANTES do merge na main.
#GITHUB_BRANCH=Duplicate-Main
